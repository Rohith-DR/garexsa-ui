{
  "appId": "com.garexsa.ui",
  "productName": "Garexsa UI",
  "compression": "normal",
  "directories": {
    "output": "dist-lite"
  },
  "files": [
    "main.js",
    "preload.js",
    "loading.html",
    "setup.html",
    "frontend/**/*",
    "icon.png"
  ],
  "linux": {
    "maintainer": "Garexsa Team <info@garexsa.local>",
    "target": [
      {
        "target": "deb",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "icon.png",
    "category": "Utility",
    "synopsis": "Chat with Gemma 4 AI Model",
    "description": "Garexsa UI is a desktop application for chatting with the Gemma 4 AI model locally. Download the model separately and place it in the models folder.",
    "desktop": {
      "Name": "Garexsa UI",
      "Comment": "Chat with Gemma 4 AI",
      "Categories": "Utility;AI;Chat",
      "Terminal": false,
      "StartupWMClass": "garexsa-ui"
    }
  },
  "deb": {
    "packageName": "garexsa-ui",
    "depends": [
      "libnotify4",
      "libxtst6",
      "libnss3",
      "libatk1.0-0",
      "libatk-bridge2.0-0",
      "libcups2",
      "libdrm2",
      "libgtk-3-0",
      "libgbm1",
      "libasound2",
      "python3",
      "python3-venv",
      "python3-pip"
    ],
    "afterInstall": "build/post-install.sh"
  },
  "extraResources": [
    {
      "from": "backend/python-embed",
      "to": "backend/python-embed"
    },
    {
      "from": "backend/wheels",
      "to": "backend/wheels"
    },
    {
      "from": "backend/setup_venv.py",
      "to": "backend/setup_venv.py"
    },
    {
      "from": "backend/models",
      "to": "backend/models",
      "filter": [
        "**/*",
        "!gemma-4-E2B-it.litertlm/**"
      ]
    },
    {
      "from": "build/README.txt",
      "to": "README.txt"
    }
  ]
}
