{
  "appId": "com.garexsa.ui.full",
  "productName": "Garexsa UI Full",
  "compression": "store",
  "directories": {
    "output": "dist-full"
  },
  "files": [
    "main.js",
    "preload.js",
    "loading.html",
    "setup.html",
    "frontend/**/*",
    "icon.png"
  ],
  "linux": {
    "maintainer": "Garexsa Team <info@garexsa.local>",
    "target": [
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "icon.png",
    "category": "Utility",
    "synopsis": "Chat with Gemma 4 AI Model (Model Included)",
    "description": "Garexsa UI is a desktop application for chatting with the Gemma 4 AI model locally. This full version includes the Gemma 4 model and is ready to use immediately.",
    "desktop": {
      "Name": "Garexsa UI Full",
      "Comment": "Chat with Gemma 4 AI",
      "Categories": "Utility;AI;Chat",
      "Terminal": false,
      "StartupWMClass": "garexsa-ui-full"
    }
  },
  "extraResources": [
    {
      "from": "backend",
      "to": "backend",
      "filter": [
        "**/*"
      ]
    }
  ]
}
