{
  "appId": "com.garexsa.ui.full",
  "productName": "Garexsa UI Full",
  "compression": "normal",
  "directories": {
    "output": "dist-full"
  },
  "files": [
    "main.js",
    "preload.js",
    "loading.html",
    "setup.html",
    "frontend/**/*",
    "icon.ico",
    "icon.png"
  ],
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "icon.ico",
    "sign": false,
    "signingHashAlgorithms": []
  },
  "portable": {
    "artifactName": "GarexsaUI-Full-Portable-${version}.exe"
  },
  "extraResources": [
    {
      "from": "backend/python-embed",
      "to": "backend/python-embed"
    },
    {
      "from": "backend/wheels",
      "to": "backend/wheels"
    },
    {
      "from": "backend/setup_venv.py",
      "to": "backend/setup_venv.py"
    },
    {
      "from": "backend/models",
      "to": "backend/models",
      "filter": [
        "**/*"
      ]
    }
  ]
}
